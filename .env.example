# SoloBBs — variables de entorno
# Copia a .env y completa los valores.

# PostgreSQL (local: docker compose up -d)
# Ejemplo local: postgresql://solobbs:solobbs@localhost:5432/solobbs?schema=public
# En Render se inyecta automáticamente desde la base de datos.
DATABASE_URL="postgresql://solobbs:solobbs@localhost:5432/solobbs?schema=public"

# Auth.js — genera con: openssl rand -base64 32
AUTH_SECRET="cambia-esto-por-un-secreto-largo"
AUTH_URL="http://localhost:3000"
NEXTAUTH_URL="http://localhost:3000"
