# Local (Docker Compose Postgres — ver docker-compose.yml)
DATABASE_URL="postgresql://solobbs:solobbs@localhost:5432/solobbs"

# Producción: PostgreSQL en Hostinger VPS
# DATABASE_URL="postgresql://solobbs:CLAVE@IP_VPS:5432/solobbs?sslmode=require"

AUTH_SECRET="cambia-esto-por-un-secreto-largo"
AUTH_URL="http://localhost:3000"
NEXTAUTH_URL="http://localhost:3000"
# En Render/Cloudflare:
# AUTH_TRUST_HOST="true"

# Tarifa visual COP por 1 USDT (fallback si falla la API de tasas en vivo)
NEXT_PUBLIC_COP_PER_USDT="4100"

# Nodo TRON para verificar firmas / txs TronLink
# TRON_FULL_HOST="https://api.trongrid.io"
# TRON_USDT_CONTRACT="TR7NHqjeKQxGTCi8q8ZY4pL8otSzgjLj6t"
# NEXT_PUBLIC_TRON_USDT_CONTRACT="TR7NHqjeKQxGTCi8q8ZY4pL8otSzgjLj6t"
# Wallet platforma (fallback si no hay companyFeeWallet en Admin)
# TRON_TREASURY_USDT="TYourRealTreasuryAddressHerexxxxxxxxxxxx"
# Clave de hot/gas wallet (fallback si no se configura en Admin → Ajustes)
# TRON_HOT_WALLET_PRIVATE_KEY=
# TRON_GAS_WALLET_ADDRESS=
# Si true, al liberar escrow también envía on-chain el split (fee + referidos + modelo)
# TRON_AUTO_SPLIT_ONCHAIN="false"
# Demo: true = permite simular confirmación y retiros sin broadcast
TRON_ESCROW_DEMO="false"
# Opcional: API key TronGrid para más rate limit al detectar depósitos
# TRONGRID_API_KEY=
# Cifrado de private keys custodiales (por defecto usa AUTH_SECRET)
# WALLET_ENC_KEY="cambia-esto-por-un-secreto-largo"

# --- Sumsub KYC ---
# SUMSUB_APP_TOKEN="sbx:..."
# SUMSUB_SECRET_KEY="..."
# SUMSUB_WEBHOOK_SECRET="..."
# SUMSUB_LEVEL_CLIENT="basic-kyc-level"
# SUMSUB_LEVEL_MODEL="basic-kyc-level"
# KYC_ENFORCE="true"
# SUMSUB_BASE_URL="https://api.sumsub.com"

# WhatsApp alerts a modelos
WHATSAPP_PROVIDER="log"
WHATSAPP_ENABLED="true"
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# CALLMEBOT_APIKEY=
